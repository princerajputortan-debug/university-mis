generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id       String @id @default(cuid())
  email    String @unique
  password String
  role     String @default("VIEWER") // ADMIN or VIEWER
}

model FeeStructure {
  id              Int    @id @default(autoincrement())
  batchId         Int
  batch           Batch @relation(fields: [batchId], references: [id])
  paymentOptionId Int
  paymentOption   PaymentOption @relation(fields: [paymentOptionId], references: [id])
  programId       Int
  program         Program @relation(fields: [programId], references: [id])
  semFee          Float

  @@unique([batchId, paymentOptionId, programId])
}

model ConsolidatedPayment {
  id                  Int       @id @default(autoincrement())
  date                DateTime?
  transactionId       String    @unique
  enrollmentId        Int?
  enrollment          Enrollment? @relation("ConsolidatedPaymentEnrollment", fields: [enrollmentId], references: [id])
  amount              Float
  mode                String?
  batchId             Int?
  batch               Batch? @relation("ConsolidatedPaymentBatch", fields: [batchId], references: [id])
  discountedCourseFee Float?
  firstEmi            Float?
  tenure              Int?
  sourceName          String // e.g. Razorpay, Jodo, Early, Offline, Bank, Propelld, Others
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model RazorpayPayment {
  id                  Int       @id @default(autoincrement())
  date                DateTime?
  transactionId       String    @unique
  enrollmentId        Int?
  enrollment          Enrollment? @relation("RazorpayPaymentEnrollment", fields: [enrollmentId], references: [id])
  amount              Float
  mode                String?
  batchId             Int?
  batch               Batch? @relation("RazorpayPaymentBatch", fields: [batchId], references: [id])
  discountedCourseFee Float?
  firstEmi            Float?
  tenure              Int?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

